### Cấu hình Host
@host = http://localhost:8080

### ====================================================================
### 1. QUẢN LÝ DANH SÁCH NGÔN NGỮ (LANGUAGES TABLE)
### ====================================================================

### 1.1. Lấy danh sách ngôn ngữ đang hoạt động (Public API)
GET {{host}}/api/v1/languages

### 1.2. Tạo Ngôn Ngữ Mới (Admin API)
POST {{host}}/api/v1/admin/languages
Content-Type: application/json

{
  "code": "vi",
  "name": "Tiếng Việt",
  "flagIcon": "🇻🇳",
  "isDefault": true,
  "status": "active",
  "orderIndex": 1
}

### 1.3. Lấy toàn bộ danh sách ngôn ngữ quản trị (Admin API)
GET {{host}}/api/v1/admin/languages


### ====================================================================
### 2. QUẢN LÝ MENUS (MAIN NAVIGATION)
### ====================================================================

### 2.1. Tạo Menu Điều Hướng Chính (MAIN_NAV)
# @name createMainMenu
POST {{host}}/api/v1/admin/menus
Content-Type: application/json

{
  "code": "MAIN_NAV",
  "name": "Thanh Điều Hướng Chính",
  "status": "active"
}

### 2.2. Lấy danh sách Menus hiện có để lấy ID
GET {{host}}/api/v1/admin/menus

### 2.3. Thêm MenuItem: Trang chủ (Home)
# Thay menuId = 1 (hoặc ID của MAIN_NAV lấy từ bước 2.2)
POST {{host}}/api/v1/admin/menus/items
Content-Type: application/json

{
  "menuId": 1,
  "urlPath": "/",
  "target": "_self",
  "iconClass": "HomeIcon",
  "orderIndex": 1,
  "status": "active",
  "translations": [
    { "locale": "vi", "title": "Trang chủ" },
    { "locale": "en", "title": "Home" },
    { "locale": "ko", "title": "홈" },
    { "locale": "ru", "title": "Главная" }
  ]
}

### 2.4. Thêm MenuItem Cha: Thuê xe (Car Rental)
# Thay menuId = 1
POST {{host}}/api/v1/admin/menus/items
Content-Type: application/json

{
  "menuId": 1,
  "urlPath": "#",
  "target": "_self",
  "iconClass": "Car",
  "orderIndex": 2,
  "status": "active",
  "translations": [
    { "locale": "vi", "title": "Thuê xe" },
    { "locale": "en", "title": "Car Rental" },
    { "locale": "ko", "title": "차량 렌트" },
    { "locale": "ru", "title": "Аренда авто" }
  ]
}

### 2.5. Lấy danh sách items để xem ID của MenuItem Cha "Thuê xe" vừa tạo
GET {{host}}/api/v1/admin/menus

### 2.6. Thêm MenuItem Con: Thuê xe đi tỉnh (Provincial Transfers)
# Thay menuId = 1, parentId = ID của "Thuê xe" vừa tạo (thường là 2 hoặc 3 tùy thuộc DB)
POST {{host}}/api/v1/admin/menus/items
Content-Type: application/json

{
  "menuId": 1,
  "parentId": 3,
  "urlPath": "/rent-car",
  "target": "_self",
  "iconClass": "",
  "orderIndex": 1,
  "status": "active",
  "translations": [
    { "locale": "vi", "title": "Thuê xe đi tỉnh" },
    { "locale": "en", "title": "Provincial Transfers" },
    { "locale": "ko", "title": "시외 차 렌트" },
    { "locale": "ru", "title": "Аренда авто с водителем" }
  ]
}

### 2.7. Thêm MenuItem Con: Thuê xe tự lái (Self-Drive Rental)
# Thay menuId = 1, parentId = ID của "Thuê xe"
POST {{host}}/api/v1/admin/menus/items
Content-Type: application/json

{
  "menuId": 1,
  "parentId": 3,
  "urlPath": "/self-drive",
  "target": "_self",
  "iconClass": "",
  "orderIndex": 2,
  "status": "active",
  "translations": [
    { "locale": "vi", "title": "Thuê Xe Tự Lái" },
    { "locale": "en", "title": "Self-Drive Rental" },
    { "locale": "ko", "title": "렌터카" },
    { "locale": "ru", "title": "Аренда авто (без водителя)" }
  ]
}

### 2.8. Thêm MenuItem: Đón tiễn sân bay (Airport Transfer)
# Thay menuId = 1
POST {{host}}/api/v1/admin/menus/items
Content-Type: application/json

{
  "menuId": 1,
  "urlPath": "/airport-transfer",
  "target": "_self",
  "iconClass": "Plane",
  "orderIndex": 3,
  "status": "active",
  "translations": [
    { "locale": "vi", "title": "Đón tiễn sân bay" },
    { "locale": "en", "title": "Airport Transfer" },
    { "locale": "ko", "title": "공항 픽업" },
    { "locale": "ru", "title": "Трансфер в аэропорт" }
  ]
}

### 2.9. Thêm MenuItem: Giới thiệu (About)
# Thay menuId = 1
POST {{host}}/api/v1/admin/menus/items
Content-Type: application/json

{
  "menuId": 1,
  "urlPath": "/about",
  "target": "_self",
  "iconClass": "Info",
  "orderIndex": 4,
  "status": "active",
  "translations": [
    { "locale": "vi", "title": "Giới thiệu" },
    { "locale": "en", "title": "About" },
    { "locale": "ko", "title": "소개" },
    { "locale": "ru", "title": "О нас" }
  ]
}


### ====================================================================
### 3. DYNAMIC PAGE & SECTION ENGINE (TRANG CHỦ - HOME)
### ====================================================================

### 3.1. Tạo Trang (Page) mới với slug 'home' cho cả 4 ngôn ngữ
# @name createPage
POST {{host}}/api/v1/admin/pages
Content-Type: application/json

{
  "status": "published",
  "translations": [
    { "locale": "vi", "title": "Trang chủ hệ thống", "slug": "home" },
    { "locale": "en", "title": "System Homepage", "slug": "home" },
    { "locale": "ko", "title": "시스템 홈페이지", "slug": "home" },
    { "locale": "ru", "title": "Главная страница hệ thống", "slug": "home" }
  ]
}

