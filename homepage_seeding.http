    },
    {
      "locale": "ru",
      "contentData": "{\"title\": \"Исследуйте Нячанг на полную\", \"subtitle\": \"Трансфер из аэропорта Камрань от 250k - Бюджетные туры по островаm\", \"bg_image\": \"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=80\", \"btn_text\": \"Забронировать\", \"btn_link\": \"/ru/services/transfers\"}"
